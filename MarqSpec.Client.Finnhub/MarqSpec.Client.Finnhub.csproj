<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <PackageId>MarqSpec.Client.Finnhub</PackageId>
    <Authors>Adam Marquette</Authors>
    <Company>MarqSpec</Company>
    <Description>A .NET client for Finnhub news REST and equities/indices market data — data-only, no execution.</Description>
    <PackageTags>Finnhub;News;API;Client;MarketData</PackageTags>
    <RepositoryUrl>https://github.com/adammarquette/MarqSpec.Client.Finnhub</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/adammarquette/MarqSpec.Client.Finnhub</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
