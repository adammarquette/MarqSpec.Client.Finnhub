<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <PackageId>MarqSpec.Client.Finnhub</PackageId>
    <Version>0.1.0</Version>
    <Authors>Adam Marquette</Authors>
    <Company>MarqSpec</Company>
    <Description>A .NET client library for the Finnhub news REST API — a data-only news source.</Description>
    <PackageTags>Finnhub;News;API;Client;MarketData</PackageTags>
    <RepositoryUrl>https://github.com/adammarquette/MarqSpec.Client.Finnhub</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/adammarquette/MarqSpec.Client.Finnhub</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

</Project>
